# Ambiente local — Laje Signature API
# Copie para .env (nunca versionar .env)

OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4

# Banco (padrão local: SQLite). Em produção use Postgres.
# SQLite:
# DATABASE_URL=sqlite:///./laje_signature.db
# Postgres (docker compose):
DATABASE_URL=postgresql+psycopg://laje:laje@localhost:5432/laje_signature

# Opcional
# LANGSMITH_TRACING=false
